# Neon PostgreSQL – use your connection string
# Format: postgresql://user:pass@host/db?sslmode=require
# Render: Set this in Render dashboard -> Environment -> DATABASE_URL
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-water-a1162y8u-pooler.ap-southeast-1.aws.neon.tech/YOUTUBE%20AD%20WORDS?sslmode=require

# Frontend URL (for CORS and payment redirects)
# Render: Set to your frontend URL (e.g., https://your-frontend.onrender.com)
FRONTEND_URL=http://localhost:5173

# Session secret (required for production - Render will auto-generate)
# Render: Auto-generated if not set, or set manually
SESSION_SECRET=your-random-secret-change-in-production

# Uplef payment (get from uplef.com dashboard)
# Render: Set these in Render dashboard -> Environment
UPLEF_API_KEY=pk_live_xxx
UPLEF_API_SECRET=sk_xxx
WEBHOOK_SECRET=your-webhook-secret

# API URL - your backend public URL (for Uplef webhook callbacks)
# Render: Set to your Render backend URL (e.g., https://youtubeadwords-backend.onrender.com)
API_URL=https://your-backend.onrender.com

# YouTube API Key (for channel search)
# Render: Set this in Render dashboard -> Environment
YOUTUBE_API_KEY=your-youtube-api-key

# Node Environment
# Render: Automatically set to 'production' on Render
NODE_ENV=production

# Port (Render sets this automatically, but you can override)
# Render: Automatically set to 10000 on free tier
PORT=5001
