generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  username  String     @unique
  password  String
  name      String?
  isBanned  Boolean    @default(false)
  bannedAt  DateTime?
  banReason String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
  cartItems CartItem[]
  sessions  Session[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CartItem {
  id        Int      @id @default(autoincrement())
  amount    Int
  price     Float
  service   String
  platform  String
  username  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              Int      @id @default(autoincrement())
  amount          Int
  price           Float
  service         String
  platform        String
  status          String   @default("PENDING") // PENDING, PROGRESS, COMPLETED, CANCELED
  username        String?
  paymentMethod   String   @default("CARD") // CARD | CRYPTO
  externalOrderId    String?  // ORDER_xxx for payment webhooks
  uplefOrderId       String?  // Uplef order ID for webhook
  cryptomusPaymentId String?  // Cryptomus payment UUID for webhook
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  createdAt       DateTime @default(now())
}
