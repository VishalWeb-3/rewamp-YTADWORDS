generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Same client for Cloudflare Workers, which can't load the Node build above
generator workerClient {
  provider = "prisma-client"
  output   = "../generated/prisma-worker"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  username  String     @unique
  usernameLower String @unique // lowercased copy: SQLite can't compare case-insensitively through Prisma
  password  String // HMAC of the browser-derived key, never the password itself
  passwordSalt String @default("") // random per-user salt the browser stretches the password with
  name      String?
  isGuest   Boolean    @default(false) // created by guest checkout; can be claimed at signup
  isBanned  Boolean    @default(false)
  bannedAt  DateTime?
  banReason String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
  cartItems CartItem[]
  sessions  Session[]
  ctaActions UserCtaAction[]
  paymentLinks PaymentLink[] @relation("MerchantLinks")
  tickets   Ticket[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  amount    Int
  price     Float
  service   String
  platform  String
  username  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Order {
  id                 Int      @id @default(autoincrement())
  amount             Int
  price              Float
  service            String
  platform           String
  status             String   @default("PENDING") // PENDING, PROGRESS, COMPLETED, CANCELED
  username           String?
  paymentMethod      String   @default("CARD") // CARD | CRYPTO
  externalOrderId    String?  // ORDER_xxx for payment webhooks
  uplefOrderId       String?  // Uplef order ID for webhook
  cryptomusPaymentId String?  // Cryptomus payment UUID for webhook
  email              String?  // checkout email the order was placed with
  details            Json?    // extra options, e.g. Google review add-ons and custom review texts
  user               User     @relation(fields: [userId], references: [id])
  userId             Int
  ipAddress          String?
  ipCity             String?
  ipCountry          String?
  ipRegion           String?
  ipLatitude         Float?
  ipLongitude        Float?
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([externalOrderId])
  @@index([uplefOrderId])
  @@index([status])
}

model CtaAction {
  id        Int      @id @default(autoincrement())
  actionKey String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserCtaAction {
  id        Int       @id @default(autoincrement())
  userId    Int
  actionKey String
  isActive  Boolean   @default(true)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime  @updatedAt

  @@unique([userId, actionKey])
}

model PaymentLink {
  id            Int               @id @default(autoincrement())
  merchantId    Int
  merchant      User              @relation("MerchantLinks", fields: [merchantId], references: [id])
  amount        Float
  currency      String            @default("USD")
  description   String
  customerName  String?
  customerEmail String?
  customerPhone String?
  expiry        DateTime?
  token         String            @unique
  type          String            @default("ONE_TIME") // ONE_TIME, REUSABLE
  maxPayments   Int?
  redirectUrl   String?
  notes         String?
  status        String            @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, COMPLETED
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  transactions  LinkTransaction[]

  @@index([merchantId])
}

model LinkTransaction {
  id             Int         @id @default(autoincrement())
  paymentLinkId  Int
  paymentLink    PaymentLink @relation(fields: [paymentLinkId], references: [id])
  gatewayOrderId String?     @unique
  status         String      @default("PENDING") // PENDING, SUCCESS, FAILED
  amount         Float
  customerEmail  String?
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([paymentLinkId])
}

model Ticket {
  id          Int      @id @default(autoincrement())
  email       String
  reason      String
  orderNumber String?
  message     String
  status      String   @default("OPEN") // OPEN, CLOSED
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([userId])
}

model Review {
  id        Int      @id @default(autoincrement())
  page      String   // service page slug the review was left on
  name      String
  email     String
  rating    Int
  text      String
  approved  Boolean  @default(false) // reviews stay hidden until moderated
  createdAt DateTime @default(now())

  @@index([page, approved])
}
